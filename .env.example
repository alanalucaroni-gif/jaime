# Credencial de teste do Mercado Pago. Nunca use esta chave no navegador.
MERCADO_PAGO_ACCESS_TOKEN=TEST-COLE_AQUI
MERCADO_PAGO_MODE=test

# URL pública do site (sem barra no final). Em desenvolvimento, use a URL local.
NEXT_PUBLIC_SITE_URL=http://localhost:3014

# Configurada no painel do Mercado Pago ao habilitar webhooks.
MERCADO_PAGO_WEBHOOK_SECRET=COLE_AQUI

# Banco de dados e acesso privado do ERP. A chave de serviço só fica no servidor.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI
SUPABASE_SERVICE_ROLE_KEY=sb_secret_COLE_AQUI

